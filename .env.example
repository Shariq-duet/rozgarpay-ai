# RozgarPay AI Environment Configuration
# AMD Developer Cloud / vLLM / OpenAI-compatible endpoint credentials

# Endpoint URL (e.g., AMD Developer Cloud vLLM container or local ROCm vLLM instance)
AMD_VLLM_BASE_URL=https://api.amd-cloud.example.com/v1
AMD_API_KEY=your_amd_vllm_api_key_here

# Model identifier deployed on AMD Instinct MI210/MI250/MI300X
# Options: Qwen/Qwen2.5-72B-Instruct, google/gemma-2-27b-it, Qwen/Qwen2.5-Coder-32B-Instruct
LLM_MODEL_NAME=Qwen/Qwen2.5-72B-Instruct

# Hardware Target Metadata (for telemetry and performance auditing)
AMD_ACCELERATOR_TARGET=AMD Instinct MI300X (192GB HBM3, ROCm 6.2)

# Operational Modes
# Set to 'true' to use the high-fidelity offline deterministic simulation if AMD Cloud credentials are not configured
MOCK_AMD_BACKEND=true

# Evolus Commercial Workflow Settings
RECONCILIATION_TOLERANCE_PERCENT=1.0
AUTO_APPROVE_THRESHOLD_USD=5000.00
DEFAULT_CURRENCY=PKR
